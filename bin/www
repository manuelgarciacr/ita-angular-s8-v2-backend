#!/usr/bin/env node

const debug = require("debug")("ita-angular-s8-ng-4-backend"); // Global function
const config = require("../src/config");
//const app = require('../src/server.mjs').default; // Importing Express server
const port = normalizePort(config.PORT || "3000");

async function startServer() {
    const { default: app } = await import("../src/server.mjs");

    if (config.IS_PRODUCTION) {
        const { readFileSync } = require("fs");
        const key = readFileSync(
            `/etc/letsencrypt/live/${config.DOM}/privkey.pem`,
        );
        const cert = readFileSync(
            `/etc/letsencrypt/live/${config.DOM}/fullchain.pem`,
        );
        const https = require("https");

        server = https.createServer({ key, cert }, app);
    } else {
        const http = require("http");

        server = http.createServer(app);
    }

    server.listen(port, function () {
        console.log(
            `${config.IS_PRODUCTION ? "HTTPS" : "HTTP"} server listening on port ${port}`,
        );
    });

    server.on("error", onError);
    server.on("listening", onListening);
}

/**
 * Normalize a port value into a number, a string (named pipe), or false.
 * Returns false if the value is not a valid port.
 */   
function normalizePort(val) {
    var port = parseInt(val, 10);

    if (isNaN(port)) return val; // named pipe
    if (port >= 0) return port; // valid port
    return false; // invalid
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
    if (error.syscall !== 'listen') {
        throw error;
    }
    const port = app.get('port');
    const bind = typeof port === 'string'
        ? 'Pipe ' + port
        : 'Port ' + port;

    // handle specific listen errors with friendly messages
    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;
        case 'EADDRINUSE':
            // lsof -i tcp:3200
            // kill -9 PID
            console.error(bind + ' is already in use');
            process.exit(1);
            break;
        default:
            throw error;
     }
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening() {
    const addr = server.address();
    const  bind = typeof addr === 'string'
        ? 'pipe ' + addr
        : 'port ' + addr.port;

    debug('debug: Listening on ' + bind);
}

/**
 * Connect to database
 */

require('../src/database');

/**
 * Listen on provided port, on all network interfaces.
 */

if (port === false) {
    console.error(`Invalid port: ${config.PORT}`);
    process.exit(1);
}
debug(port);

startServer().catch(error => {
    console.error("Server startup failed:", error);
    process.exit(1);
});
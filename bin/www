#!/usr/bin/env node

/**
 * Setting environment
 */

debug = require("debug")("ita-angular-s8-ng-4-backend"); // Global function
require('dotenv').config(); // Environment vars

const app = require('../src/server'); // Importing Express server
const http = require('http');
const https = require("https");
const isProduction = process.env.NODE_ENV === "production";
const DOM = process.env.DOM;
const { readFileSync } = require("fs");
const key = readFileSync(`/etc/letsencrypt/live/${DOM}/privkey.pem`)
const cert = readFileSync(`/etc/letsencrypt/live/${DOM}/fullchain.pem`)

/**
 * Connect to database
 */

require('../src/database');

/**
 * Listen on provided port, on all network interfaces.
 */

app.get('port').then(port => {
    if (isProduction) {
        const options = {
            key,
            cert
        };
        server = https.createServer(options, app);
    } else {
        server = http.createServer(app);
    }

    // var listener = server.listen(port, function(){
    server.listen(port, function(){
        console.log(
            `${isProduction ? "HTTPS" : "HTTP"} server listening on port ${port}`,
        );
    });
    server.on('error', onError);
    server.on('listening', onListening);
}).catch(err => console.error("ERROR:", err))
  
/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
    if (error.syscall !== 'listen') {
        throw error;
    }
    const port = app.get('port');
    const bind = typeof port === 'string'
        ? 'Pipe ' + port
        : 'Port ' + port;

    // handle specific listen errors with friendly messages
    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;
        case 'EADDRINUSE':
            // lsof -i tcp:3200
            // kill -9 PID
            console.error(bind + ' is already in use');
            process.exit(1);
            break;
        default:
            throw error;
     }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
    const addr = server.address();
    const  bind = typeof addr === 'string'
        ? 'pipe ' + addr
        : 'port ' + addr.port;

    debug('debug: Listening on ' + bind);
}
